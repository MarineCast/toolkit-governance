# Optional path-only settings. Copy to .env; keep local .env untracked.
# Relative paths in this file resolve beside it; no variable expansion.
# Workspace: --workspace > process GOVERNANCE_WORKSPACE > cwd (not set here).
GOVERNANCE_CONFIG=config/data/governance/governance.yaml
GOVERNANCE_OUTPUT_DIRECTORY=../../Data/Governance
# Supply the consumer's actual grids; JSON array inside single quotes.
# GOVERNANCE_GRIDS='["/absolute/path/to/h3-grid.parquet"]'
# Optional verified existing flat directory for offline reuse:
# GOVERNANCE_ORIGINAL_DATA=../../Data/Governance
